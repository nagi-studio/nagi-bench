{
  "name": "dust2-5v5-fps",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "Browser-playable 3D FPS prototype: Dust2 core areas, 5v5 with AI, C4 rounds. React 18 + TypeScript + three.js, fully procedural (no external assets).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:map": "tsx scripts/test-map.ts",
    "test:sim": "node scripts/sim.mjs",
    "test:damage": "tsx scripts/test-damage.ts",
    "test:scenario": "node scripts/scenario.mjs",
    "test": "npm run test:map && npm run test:damage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.166.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.11"
  }
}