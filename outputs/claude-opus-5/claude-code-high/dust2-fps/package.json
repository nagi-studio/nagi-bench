{
  "name": "dust2-fps-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural 3D FPS prototype: 5v5 Dust2 with React + TypeScript + three.js, zero external assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:map && npm run test:nav && npm run test:soak",
    "test:unit": "node --experimental-strip-types tools/unit.ts",
    "test:map": "node --experimental-strip-types tools/mapcheck.ts",
    "test:nav": "node --experimental-strip-types tools/navcheck.ts",
    "test:soak": "node --experimental-strip-types tools/verify.ts 600",
    "test:tsx": "node tools/tsxcheck.mjs",
    "map": "node --experimental-strip-types tools/asciimap.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
