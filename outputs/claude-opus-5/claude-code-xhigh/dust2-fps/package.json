{
  "name": "dust2-fps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural Dust2 5v5 FPS prototype — React + TypeScript + three.js, zero external assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/checkall.ts",
    "test:map": "node tools/mapcheck.ts",
    "test:nav": "node tools/navcheck.ts",
    "test:sim": "node tools/simtest.ts",
    "test:render": "node --import ./tools/mock/hook.mjs tools/rendercheck.ts",
    "test:balance": "node tools/balance.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
