{
  "name": "dust2-fps-proto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural Dust2 5v5 first-person shooter prototype (React + TypeScript + three.js, zero external assets)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "map:check": "esbuild src/game/map/mapCheck.ts --bundle --platform=node --format=esm --outfile=.tmp/mapcheck.mjs && node .tmp/mapcheck.mjs",
    "sim": "esbuild src/game/simCheck.ts --bundle --platform=node --format=esm --outfile=.tmp/sim.mjs && node .tmp/sim.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.21.5",
    "@rollup/rollup-win32-x64-msvc": "^4.64.1"
  }
}
