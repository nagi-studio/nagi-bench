{
  "name": "dust2-fps-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural Dust2 5v5 FPS prototype built with React + TypeScript + three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty",
    "test": "tsx scripts/validateSystems.ts && tsx scripts/validateMap.ts && tsx scripts/sim.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
