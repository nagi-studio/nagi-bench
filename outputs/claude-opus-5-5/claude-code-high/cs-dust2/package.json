{
  "name": "dust2-fps",
  "private": true,
  "version": "1.0.0",
  "description": "Browser 5v5 Dust2 FPS prototype - React + TypeScript + three.js, fully procedural (no asset files).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:syntax && npm run test:nav && npm run test:mechanics && npm run test:sim && npm run test:client",
    "test:syntax": "node --experimental-strip-types tests/syntaxcheck.ts",
    "test:nav": "node --experimental-strip-types tests/navcheck.ts",
    "test:mechanics": "node --experimental-strip-types tests/mechanics.ts",
    "test:sim": "node --experimental-strip-types tests/simulate.ts 10",
    "test:client": "node --experimental-strip-types --import ./tests/stubs/register.mjs tests/clientsim.ts 3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
