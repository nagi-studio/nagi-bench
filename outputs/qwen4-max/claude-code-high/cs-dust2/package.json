{
  "name": "dust2-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "node --import ./scripts/register.mjs scripts/verify.ts",
    "rulestest": "node --import ./scripts/register.mjs scripts/rules-test.ts",
