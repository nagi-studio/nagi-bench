{
  "name": "dust2-5v5-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural Dust2 5v5 FPS prototype — React 18 + TypeScript + three.js, zero external assets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:core": "node test/core.test.ts",
    "test:map": "node test/map.check.ts",
    "test:ui": "node --import ./test/ui-register.mjs test/ui.test.ts",
    "test:render": "node --import ./test/ui-register.mjs test/render.test.ts",
    "test": "npm run test:map && npm run test:core && npm run test:ui && npm run test:render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
